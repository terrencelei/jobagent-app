# Copy to .env (gitignored) and fill in. Placeholders only; never commit real keys.

# Database: SQLite by default; use Postgres in production (postgres:// URLs are accepted).
DATABASE_URL=sqlite:///./jobagent.db

# AI gateway
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_UPSTREAM_URL=https://api.anthropic.com
ALLOWED_MODELS=claude-fable-5-2,claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
DEFAULT_MODEL=claude-opus-5-5
MONTHLY_TOKEN_BUDGET=20000000
TRIAL_TOKEN_BUDGET=200000
RATE_LIMIT_PER_MINUTE=60
UPSTREAM_TIMEOUT_SECONDS=600

# Stripe
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PRICE_ID=price_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
CHECKOUT_SUCCESS_URL=https://example.com/billing/success
CHECKOUT_CANCEL_URL=https://example.com/billing/cancel
PORTAL_RETURN_URL=https://example.com/account
